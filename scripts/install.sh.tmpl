#!/bin/sh
# fobe agent install script (design.md §5.2).
# Rendered by the server from scripts/install.sh.tmpl; {{.DefaultServer}} /
# {{.DefaultToken}} carry optional query-string defaults, real values come
# from --token / --server args.
#
# Runs as root directly (most VPS have no sudo) and elevates via sudo only
# when started by a non-root user that has sudo installed.
set -eu

DEFAULT_SERVER="{{.DefaultServer}}"
DEFAULT_TOKEN="{{.DefaultToken}}"

TOKEN=""
SERVER=""
BIN_DIR="/usr/local/bin"
while [ $# -gt 0 ]; do
    case "$1" in
        --token)  TOKEN="$2";  shift 2 ;;
        --server) SERVER="$2"; shift 2 ;;
        --token=*)  TOKEN="${1#*=}";  shift ;;
        --server=*) SERVER="${1#*=}"; shift ;;
        *) echo "unknown arg: $1" >&2; exit 1 ;;
    esac
done
SERVER="${SERVER:-$DEFAULT_SERVER}"
TOKEN="${TOKEN:-$DEFAULT_TOKEN}"
[ -n "$SERVER" ] || { echo "fobe: --server is required" >&2; exit 1; }
[ -n "$TOKEN" ]  || { echo "fobe: --token is required"  >&2; exit 1; }

# privilege handling: pure root is the common VPS case and needs nothing;
# a non-root user with sudo gets elevated; anything else fails loudly.
SUDO=""
if [ "$(id -u)" != "0" ]; then
    if command -v sudo >/dev/null 2>&1; then
        SUDO="sudo"
        echo "fobe: not running as root; elevating with sudo"
    else
        echo "fobe: must run as root (this box has no sudo; re-run as root)" >&2
        exit 1
    fi
fi

# put_file MODE SRC DST — the `install -m` equivalent. 部分OpenWrt构建的
# busybox(实测Kwrt)没编install applet，首装会在第一条install处"install: not found"；
# 且重装时目标可能是正在运行的agent二进制，cp原地写会被ETXTBSY拒绝——先unlink让
# 活进程留在旧inode上，由随后的服务restart把新二进制换上来(与enable/restart陷阱同一语义)。
put_file() {
    $SUDO rm -f "$3"
    $SUDO cp "$2" "$3"
    $SUDO chmod "$1" "$3"
}

# 1. architecture gate: v1 ships x86_64 only, fail loudly otherwise (§5.2)
ARCH="$(uname -m)"
[ "$ARCH" = "x86_64" ] || { echo "fobe: unsupported architecture '$ARCH' (v1 is x86_64 only)" >&2; exit 1; }

# 2. service-manager detection (§5.3)
if [ -d /run/systemd/system ]; then
    INIT=systemd
elif [ -x /sbin/procd ] || [ -f /etc/rc.common ]; then
    INIT=procd
    BIN_DIR="/usr/bin"          # OpenWrt: overlay-persistent /usr/bin (§5.4)
else
    INIT=fallback
fi

echo "fobe: server=$SERVER init=$INIT"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# 3. download + sha256 verify (checksum comes from the server's manifest)
DL="$SERVER/dl/agent/latest/linux-amd64"
echo "fobe: downloading agent from $DL"
if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$DL" -o "$TMP/fobe-agent"
else
    wget -qO "$TMP/fobe-agent" "$DL"
fi

# checksum: prefer the server's sidecar file; refuse unsigned installs
if curl -fsSL "$DL.sha256" -o "$TMP/fobe-agent.sha256" 2>/dev/null \
   || wget -qO "$TMP/fobe-agent.sha256" "$DL.sha256" 2>/dev/null; then
    EXPECTED="$(awk '{print $1}' "$TMP/fobe-agent.sha256")"
    if command -v sha256sum >/dev/null 2>&1; then
        ACTUAL="$(sha256sum "$TMP/fobe-agent" | awk '{print $1}')"
    else
        ACTUAL="$(sha256 "$TMP/fobe-agent" | awk '{print $NF}')"
    fi
    [ "$EXPECTED" = "$ACTUAL" ] || { echo "fobe: checksum mismatch" >&2; exit 1; }
else
    echo "fobe: WARNING: no checksum published by server; aborting" >&2
    exit 1
fi

put_file 0755 "$TMP/fobe-agent" "$BIN_DIR/fobe-agent"

# 4-5. register (reuses prior credentials on reinstall, §4.2)
$SUDO mkdir -p /etc/fobe-agent
if ! $SUDO "$BIN_DIR/fobe-agent" -register -token "$TOKEN" -server "$SERVER"; then
    echo "fobe: registration failed" >&2
    exit 1
fi

# 6. install + start the service (files are staged in $TMP and installed via
#    put_file, so redirects never need a root shell)
case "$INIT" in
    systemd)
        cat > "$TMP/fobe-agent.service" <<UNIT
[Unit]
Description=fobe probe agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=$BIN_DIR/fobe-agent -config /etc/fobe-agent/config.json -run
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
UNIT
        put_file 0644 "$TMP/fobe-agent.service" /etc/systemd/system/fobe-agent.service
        $SUDO systemctl daemon-reload
        # restart, NOT `enable --now`: this script is also the panel's
        # "reinstall command" (§5.5), which runs on a node whose agent is
        # already up. `systemctl enable --now` is a no-op for an already-active
        # unit, so the new binary would be installed and never executed — the
        # node keeps reporting the old version no matter how often you reinstall
        # (the tell is `systemctl status`: Active since long before the install).
        # `restart` also starts a stopped unit, so the fresh-install case is
        # covered by the same line.
        $SUDO systemctl enable fobe-agent.service
        $SUDO systemctl restart fobe-agent.service
        ;;
    procd)
        # unquoted heredoc so the agent path follows the procd BIN_DIR probe;
        # it used to hardcode /usr/bin and could silently drift from it.
        cat > "$TMP/fobe-agent.initd" <<INITD
#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99

start_service() {
	procd_open_instance
	procd_set_param command $BIN_DIR/fobe-agent -config /etc/fobe-agent/config.json -run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
INITD
        # the initd script goes to /etc/init.d/, NOT the binary — this line
        # once installed "$TMP/fobe-agent" here, clobbering the init script
        # with an ELF binary on real OpenWrt and taking procd down with it.
        put_file 0755 "$TMP/fobe-agent.initd" /etc/init.d/fobe-agent
        $SUDO /etc/init.d/fobe-agent enable
        # stop-then-start instead of `restart`: rc.common's restart is literally
        # stop+start, but on a fresh install procd has never seen the service and
        # the stop step makes ubus print "Command failed: Not found" — exit status
        # stays 0, purely cosmetic, yet it reads like a failure. Silencing only
        # the stop keeps the fresh-install output clean; start's real errors still
        # surface. On reinstall this still really stops the running agent (§5.5):
        # a bare `start` would be a no-op and leave the old binary in charge.
        $SUDO /etc/init.d/fobe-agent stop >/dev/null 2>&1 || true
        $SUDO /etc/init.d/fobe-agent start
        ;;
    fallback)
        echo "fobe: no service manager found; start the agent manually:"
        echo "  $BIN_DIR/fobe-agent -config /etc/fobe-agent/config.json -run"
        $SUDO mkdir -p /var/log
        # Reinstalling with no supervisor used to leave the previous nohup'd
        # agent alive on the replaced inode, so two agents fought over one node
        # credential (the hub closes whichever connected first). Stop it first;
        # the path anchor keeps the pattern from matching this install script.
        $SUDO pkill -f "^$BIN_DIR/fobe-agent" 2>/dev/null || true
        $SUDO sh -c "nohup $BIN_DIR/fobe-agent -config /etc/fobe-agent/config.json -run >/var/log/fobe-agent.log 2>&1 &"
        ;;
esac

echo "fobe: installed. the node should appear in the panel within seconds."
