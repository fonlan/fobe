# fobe production image (design.md §17): three build stages —
#   1. node:    compile the React frontend into web/dist
#   2. golang:  build fobe-server + fobe-agent (linux/amd64, CGO off)
#   3. runtime: server binary + /srv/web + the agent seed + install script
# No nginx inside: TLS and reverse proxying are the operator's external job.
#
# The agent build lands in /srv/agent-seed, deliberately NOT in /srv/dl: compose
# bind-mounts the host's data/dl over /srv/dl, which hides whatever the image put
# there, so §5.5 artifacts shipped into /srv/dl would be invisible at runtime.
# The server copies the seed into the artifact volume at startup.

FROM node:22-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json* ./
RUN npm ci || npm install
COPY web/ ./
RUN npm run build

FROM golang:1.25-alpine AS build
WORKDIR /src
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -ldflags "-X main.version=$VERSION" -o /out/fobe-server ./cmd/server \
 && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
      -ldflags "-s -w -X github.com/fobe-panel/fobe/internal/agent.Version=$VERSION" \
      -o /out/agent-seed/agent/$VERSION/linux-amd64 ./cmd/agent \
 && sha256sum /out/agent-seed/agent/$VERSION/linux-amd64 | awk '{print $1}' > /out/agent-seed/agent/$VERSION/linux-amd64.sha256 \
 && printf '{"version":"%s","artifacts":[{"os":"linux","arch":"amd64","file":"linux-amd64"}]}\n' "$VERSION" \
      > /out/agent-seed/agent/$VERSION/manifest.json

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && mkdir -p /srv/dl
COPY --from=build /out/fobe-server /usr/local/bin/fobe-server
# The seed stays outside the artifact volume on purpose (see the header).
COPY --from=build /out/agent-seed/ /srv/agent-seed/
COPY --from=web /src/web/dist/ /srv/web/
COPY scripts/install.sh.tmpl /srv/install.sh.tmpl

ENV FOBE_DB=/data/fobe.db \
    FOBE_WEB_DIR=/srv/web \
    FOBE_DL_DIR=/srv/dl \
    FOBE_AGENT_SEED_DIR=/srv/agent-seed \
    FOBE_LISTEN=0.0.0.0:8080 \
    FOBE_BACKUP_DIR=/backup
EXPOSE 8080
# /srv/dl holds the seeded agent artifacts plus the auto-downloaded sing-box
# versions; without a volume/bind mount an image upgrade drops them. The server
# re-seeds the agent builds from /srv/agent-seed on every start and warns when
# /srv/dl is not a mount of its own.
VOLUME ["/data", "/backup", "/srv/dl"]
ENTRYPOINT ["/usr/local/bin/fobe-server"]
