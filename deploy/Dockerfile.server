# fobe production image (design.md §17): three build stages —
#   1. node:    compile the React frontend into web/dist
#   2. golang:  build fobe-server + fobe-agent (linux/amd64, CGO off)
#   3. runtime: server binary + /srv/web + the agent seed + install script
# No nginx inside: TLS and reverse proxying are the operator's external job.
# Everything a deployment needs ships in this one image; the entrypoint makes
# the master key optional at `docker compose up` time (generated into the
# /data volume when unset, §4.4).
#
# The agent build lands in /srv/agent-seed, deliberately NOT inside the data
# volume: compose bind-mounts the host's ./data over /data and FOBE_DL_DIR
# lives inside that mount (/data/dl), so anything the image put there would be
# invisible at runtime. The server copies the seed into the artifact volume at
# startup.

FROM node:22-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json* ./
RUN npm ci || npm install
COPY web/ ./
RUN npm run build

FROM golang:1.25-alpine AS build
WORKDIR /src
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
ARG VERSION=dev
# A placeholder VERSION ("", dev, compose — the shapes IsReleaseVersion rejects)
# is replaced by a content-addressed build id, mirroring scripts/dev.sh (design
# §5.5 / §227): fingerprint a placeholder agent build, take the first 12 hex
# chars of its sha256, prepend a 0 when there is no digit at all. The target
# version is compared by *equality* (agent version == server version), so a
# constant "compose" could never trigger §5.5 follow-the-server even across a
# rebuild; the fingerprint moves only when the agent binary actually changes.
# Go builds are reproducible, so identical source keeps the same id.
# An explicit non-placeholder VERSION (the release pipeline passes the tag)
# goes through untouched.
# The final id lives in $VER, not $VERSION on purpose: Docker substitutes ARG
# names into the RUN text at parse time, so reassigning VERSION in the shell
# cannot affect the already-substituted occurrences below.
RUN set -eu; \
    VER="$VERSION"; \
    case "$VER" in \
      ""|dev|compose) \
        base="$VER"; \
        if [ -z "$base" ]; then base="dev"; fi; \
        CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
          -ldflags "-s -w -X github.com/fonlan/fobe/internal/agent.Version=$base-pending" \
          -o /tmp/agent-pending ./cmd/agent; \
        fp="$(sha256sum /tmp/agent-pending | cut -c1-12)"; \
        case "$fp" in *[0-9]*) ;; *) fp="0$fp" ;; esac; \
        VER="$base-$fp"; \
      ;; \
    esac; \
    CGO_ENABLED=0 go build -ldflags "-X main.version=$VER" -o /out/fobe-server ./cmd/server \
 && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
      -ldflags "-s -w -X github.com/fonlan/fobe/internal/agent.Version=$VER" \
      -o /out/agent-seed/agent/$VER/linux-amd64 ./cmd/agent \
 && sha256sum /out/agent-seed/agent/$VER/linux-amd64 | awk '{print $1}' > /out/agent-seed/agent/$VER/linux-amd64.sha256 \
 && printf '{"version":"%s","artifacts":[{"os":"linux","arch":"amd64","file":"linux-amd64"}]}\n' "$VER" \
      > /out/agent-seed/agent/$VER/manifest.json

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/fobe-server /usr/local/bin/fobe-server
# The seed stays outside the artifact volume on purpose (see the header).
COPY --from=build /out/agent-seed/ /srv/agent-seed/
COPY --from=web /src/web/dist/ /srv/web/
COPY scripts/install.sh.tmpl /srv/install.sh.tmpl
# Entry wrapper: resolves FOBE_MASTER_KEY (env → key file → generate into the
# /data volume) so a fresh deployment needs no .env at all, and routes
# `admin` subcommands past the key requirement.
COPY deploy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV FOBE_DB=/data/fobe.db \
    FOBE_WEB_DIR=/srv/web \
    FOBE_DL_DIR=/data/dl \
    FOBE_AGENT_SEED_DIR=/srv/agent-seed \
    FOBE_LISTEN=0.0.0.0:8080 \
    FOBE_BACKUP_DIR=/data/backup
EXPOSE 8080
# One data volume: db + master key + GeoIP at /data, artifact cache and daily
# backups in /data/dl and /data/backup. The server re-seeds the agent builds
# from /srv/agent-seed (deliberately outside the volume) on every start, and
# the mount check warns when /data/dl lands on the container's writable layer.
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
