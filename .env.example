# fobe environment (copy to .env, keep out of git)
# Master key for AES-GCM encryption of AI keys / SSH credentials / bot tokens.
# Generate: openssl rand -base64 32
FOBE_MASTER_KEY=

# Admin password source of truth: on every start the password is synced to
# this value (a change revokes all old sessions). Leave unset to keep the
# current password.
#FOBE_ADMIN_PASSWORD=

# Optional: container image version label used during build
#FOBE_VERSION=compose
