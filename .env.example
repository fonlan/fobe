# fobe environment (copy to .env, keep out of git)
# Master key for AES-GCM encryption of AI keys / SSH credentials / bot tokens.
# Generate: openssl rand -base64 32
FOBE_MASTER_KEY=

# Admin password source of truth: on every start the password is synced to
# this value (a change revokes all old sessions). Leave unset to keep the
# current password.
#FOBE_ADMIN_PASSWORD=

# --- sing-box artifact cache (design §9.2) ---
# On startup, when <FOBE_DL_DIR>/singbox holds no valid version, the server
# downloads the current stable sing-box release in the background; a cache that
# is already warm never touches the network. Set to 0 to turn it off (the panel
# then only offers versions you put there yourself).
#FOBE_SINGBOX_AUTO_DOWNLOAD=1

# Release source overrides, for mirrors and air-gapped installs (a
# GitHub-compatible API root and the release download root).
#FOBE_SINGBOX_API_BASE=https://api.github.com
#FOBE_SINGBOX_DOWNLOAD_BASE=https://github.com

# Optional: container image version label used during build
#FOBE_VERSION=compose
